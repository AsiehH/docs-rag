-notice-706", "content_id": "dc55ddc7-e057-42e9-83df-caf4646abfc8", "document_type": "detailed_guide", "links": {}, "locale": "en", "public_updated_at": "2025-12-16T14:51:57Z", "schema_name": "detailed_guide", "title": "Partial exemption (VAT Notice 706)", "web_url": "https://www.gov.uk/guidance/partial-exemption-vat-notice-706", "withdrawn": false}, {"api_path": "/api/content/hmrc-internal-manuals/vat-partial-exemption-guidance/pe68000", "api_url": "https://www.gov.uk/api/content/hmrc-internal-manuals/vat-partial-exemption-guidance/pe68000", "base_path": "/hmrc-internal-manuals/vat-partial-exemption-guidance/pe68000", "content_id": "9a0d7bef-38c6-57b1-8259-cc1028748d4b", "document_type": "hmrc_manual_section", "links": {}, "locale": "en", "public_updated_at": "2022-02-22T11:44:10Z", "schema_name": "hmrc_manual_section", "title": "Other Partial Exemption issues: Movement of own goods: Contents", "web_url": "https://www.gov.uk/hmrc-internal-manuals/vat-partial-exemption-guidance/pe68000", "withdrawn": false}], "organisations": [{"analytics_identifier": "D25", "api_path": "/api/content/government/organisations/hm-revenue-customs", "api_url": "https://www.gov.uk/api/content/government/organisations/hm-revenue-customs", "base_path": "/government/organisations/hm-revenue-customs", "content_id": "6667cce2-e809-4e21-ae09-cb0bdc1ddda3", "details": {"acronym": "HMRC", "brand": "hm-revenue-customs", "default_news_image": {"high_resolution_url": "https://assets.publishing.service.gov.uk/media/5efdb7ace90e075c58556288/s960_HMRC_sign__media_library_-_alternative__GOVUK_960.jpg", "url": "https://assets.publishing.service.gov.uk/media/5efdb7ac3a6f4023cb365a65/s300_HMRC_sign__media_library_-_alternative__GOVUK_960.jpg"}, "logo": {"crest": "hmrc", "formatted_title": "HM Revenue<br/>&amp; Customs"}, "organisation_govuk_status": {"status": "live", "updated_at": null, "url": null}}, "document_type": "organisation", "links": {}, "locale": "en", "schema_name": "organisation", "title": "H